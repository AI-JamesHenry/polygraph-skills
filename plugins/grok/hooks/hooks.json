{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "polygraph[-_]?(mcp)?_+(spawn_agent|show_agent)",
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/hooks/remind-subagents.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "polygraph[-_]?(mcp)?_+",
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/hooks/record-session-mapping.mjs grok",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/hooks/reinject-polygraph-context.mjs",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/hooks/record-session-mapping.mjs grok",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/hooks/finalize-agent-session.mjs grok",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
