{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      { "command": "node ./hooks/polygraph-diagnostic.mjs" }
    ],
    "postToolUse": [{ "command": "node ./hooks/polygraph-diagnostic.mjs" }],
    "afterAgentResponse": [
      { "command": "node ./hooks/polygraph-diagnostic.mjs" }
    ],
    "afterAgentThought": [
      { "command": "node ./hooks/polygraph-diagnostic.mjs" }
    ],
    "afterFileEdit": [{ "command": "node ./hooks/polygraph-diagnostic.mjs" }],
    "subagentStop": [{ "command": "node ./hooks/polygraph-diagnostic.mjs" }],
    "stop": [{ "command": "node ./hooks/polygraph-diagnostic.mjs" }]
  }
}
